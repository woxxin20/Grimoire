# Backend API Keys for Gemini Rotation Manager
# System rotates through 1 -> 2 -> 3 -> 4 automatically on rate limits/auth errors
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here

# RuVector Configuration (Optional - falls back to embedded vector engine if empty)
RUVECTOR_URL=http://localhost:8080
RUVECTOR_API_KEY=your_ruvector_key

# Application Settings
PORT=3001
STORAGE_PATH=./data/storage
AUTH_SECRET=personal_mind_secret_key_change_me
