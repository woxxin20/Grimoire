{
  "name": "personal-mind",
  "version": "1.0.0",
  "description": "Personal AI Mind / Second Brain Web Application with RuVector & Gemini",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:vite": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:vite": "vite build",
    "build": "npm run build:server && npm run build:vite",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:ui": "npm run build:vite && playwright test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bootstrap": "^5.3.8",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
